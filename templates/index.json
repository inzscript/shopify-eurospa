      "custom_liquid_K8hMqp": {
        "type": "custom-liquid",
        "settings": {
          "custom_liquid": "<div class=\"quiz-container\">\n  <style>\n    .quiz-container {\n      max-width: 800px;\n      margin: 40px auto;\n      padding: 20px;\n      font-family: Arial, sans-serif;\n    }\n    .quiz-step {\n      display: none;\n    }\n    .quiz-step.active {\n      display: block;\n    }\n    .quiz-button {\n      display: block;\n      width: 100%;\n      padding: 15px;\n      margin: 10px 0;\n      border: 1px solid #E0D9CF;\n      border-radius: 8px;\n      background: white;\n      color: #666366;\n      text-align: left;\n      cursor: pointer;\n    }\n    .quiz-button:hover {\n      background: #E0D9CF;\n    }\n    .progress-bar {\n      background: #E0D9CF;\n      height: 8px;\n      border-radius: 4px;\n      margin: 20px 0;\n    }\n    .progress-bar-fill {\n      background: #94765B;\n      height: 100%;\n      width: 20%;\n      border-radius: 4px;\n      transition: width 0.3s ease;\n    }\n    .quiz-heading {\n      color: #666366;\n      font-size: 24px;\n      text-align: center;\n      margin-bottom: 20px;\n    }\n    .quiz-question {\n      color: #666366;\n      font-size: 18px;\n      margin-bottom: 20px;\n    }\n    .result-card {\n      background: #E0D9CF;\n      padding: 20px;\n      border-radius: 8px;\n      margin: 20px 0;\n      color: #666366;\n    }\n  </style>\n\n  <h1 class=\"quiz-heading\">Discover Your Personal Spa Profile Preference</h1>\n  \n  <div class=\"progress-bar\">\n    <div class=\"progress-bar-fill\"></div>\n  </div>\n\n  <!-- Question 1 -->\n  <div class=\"quiz-step active\" data-step=\"1\">\n    <p class=\"quiz-question\"></p>\n    <button class=\"quiz-button\" data-profile=\"energy\">I need to recharge and feel energized</button>\n    <button class=\"quiz-button\" data-profile=\"calm\">I want to relax and find inner peace</button>\n    <button class=\"quiz-button\" data-profile=\"sensual\">I'm seeking a luxurious escape</button>\n    <button class=\"quiz-button\" data-profile=\"focus\">I need to clear my mind and focus</button>\n  </div>\n\n  <!-- Question 2 -->\n  <div class=\"quiz-step\" data-step=\"2\">\n    <p class=\"quiz-question\">When do you typically make time for self-care?</p>\n    <button class=\"quiz-button\" data-profile=\"energy\">Morning - it sets the tone for my day</button>\n    <button class=\"quiz-button\" data-profile=\"calm\">Evening - to unwind after a long day</button>\n    <button class=\"quiz-button\" data-profile=\"bliss\">Weekends - when I can fully immerse</button>\n    <button class=\"quiz-button\" data-profile=\"masculine\">Whenever I can squeeze it in</button>\n  </div>\n\n  <!-- Question 3 -->\n  <div class=\"quiz-step\" data-step=\"3\">\n    <p class=\"quiz-question\">Which scent profile appeals to you most?</p>\n    <button class=\"quiz-button\" data-profile=\"energy\">Fresh and invigorating</button>\n    <button class=\"quiz-button\" data-profile=\"masculine\">Warm and comforting</button>\n    <button class=\"quiz-button\" data-profile=\"sensual\">Floral and romantic</button>\n    <button class=\"quiz-button\" data-profile=\"focus\">Clean and pure</button>\n  </div>\n\n  <!-- Results -->\n  <div class=\"quiz-step\" data-step=\"results\">\n    <div class=\"result-card\">\n      <h2 style=\"margin-bottom: 15px;\">Your Spa Profile</h2>\n      <p class=\"result-description\"></p>\n    </div>\n  </div>\n\n  <script>\n    const profileData = {\n      energy: \"You need products that energize and revitalize. Try our Eucalyptus + Lemongrass blend for an invigorating boost to start your day.\",\n      calm: \"You value tranquility and peace. Our Eucalyptus + Lavender blend and Sleep Well Pillow Mist will help you unwind and find serenity.\",\n      focus: \"You seek clarity and mental sharpness. Our Eucalyptus + Lemongrass blend will help you maintain focus and productivity.\",\n      bliss: \"You seek pure joy and relaxation. Our Eucalyptus + Jasmine blend will transport you to a state of bliss.\",\n      masculine: \"You appreciate bold, distinctive scents. Our Eucalyptus + Woodsmoke & Leather blend offers a perfect balance of strength and refinement.\",\n      sensual: \"You desire an indulgent escape. Our Eucalyptus + Jasmine blend creates an atmosphere of luxury and romance.\"\n    };\n\n    let currentStep = 1;\n    const totalSteps = 3;\n    let profileScores = {};\n\n    function updateProgress() {\n      const progress = (currentStep / totalSteps) * 100;\n      document.querySelector('.progress-bar-fill').style.width = progress + '%';\n    }\n\n    function showNextStep() {\n      document.querySelector(`[data-step=\"${currentStep}\"]`).classList.remove('active');\n      currentStep++;\n      \n      if (currentStep <= totalSteps) {\n        document.querySelector(`[data-step=\"${currentStep}\"]`).classList.add('active');\n        updateProgress();\n      } else {\n        showResults();\n      }\n    }\n\n    function calculateProfile() {\n      let maxScore = 0;\n      let topProfile = '';\n      \n      Object.entries(profileScores).forEach(([profile, score]) => {\n        if (score > maxScore) {\n          maxScore = score;\n          topProfile = profile;\n        }\n      });\n      \n      return topProfile;\n    }\n\n    function showResults() {\n      const profile = calculateProfile();\n      document.querySelector(`[data-step=\"results\"]`).classList.add('active');\n      document.querySelector('.result-description').textContent = profileData[profile];\n    }\n\n    document.querySelectorAll('.quiz-button').forEach(button => {\n      button.addEventListener('click', function() {\n        const profile = this.getAttribute('data-profile');\n        profileScores[profile] = (profileScores[profile] || 0) + 1;\n        showNextStep();\n      });\n    });\n  </script>\n</div>",
          "color_scheme": "scheme-9ce77f34-2e82-43a3-9567-63139d054c16",
          "padding_top": 0,
          "padding_bottom": 0
        }
      },
