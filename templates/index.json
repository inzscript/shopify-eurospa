      "multirow_UzAEqq": {
        "type": "multirow",
        "blocks": {
          "row_U8ihzR": {
            "type": "row",
            "settings": {
              "image": "shopify://shop_images/UltimateSpaBundle-min.jpg",
              "caption": "Bundle & Save",
              "heading": "Bundles",
              "text": "<p>Bundle Up Your Savings on Must-Have Essentials!</p>",
              "button_label": "Bundle & Save",
              "button_link": "shopify://collections/bundles"
            }
          },
          "row_dHBPEF": {
            "type": "row",
            "settings": {
              "image": "shopify://shop_images/1_77d93a74-bd2f-44a7-b5ea-ce7ae4df4dcf.png",
              "caption": "Spa Profile",
              "heading": "Focus & Energy",
              "text": "<p>Energize and invigorate your day with the <strong>Focus & Energy Collection</strong>. Featuring the fresh, citrusy <strong>Eucalyptus + Lemongrass Blend ShowerSpa Mist</strong> and the classic, revitalizing <strong>Eucalyptus ShowerSpa Mist</strong>, this collection awakens your senses and sharpens focus. Ideal for morning routines or a refreshing pick-me-up, these mists transform your shower into an energizing wellness retreat. Perfect for fitness areas, steam rooms, or home showers, this collection revitalizes both body and mind.</p>",
              "button_label": "Explore",
              "button_link": "shopify://collections/focus-energy"
            }
          },
          "row_pw48Ex": {
            "type": "row",
            "settings": {
              "image": "shopify://shop_images/3_063ae7b1-4fd4-4f44-bd8e-c9fceab46c04.png",
              "caption": "Spa Profile",
              "heading": "Calm",
              "text": "<p>Find serenity and peace with the <strong>Calm Collection</strong>, featuring the <strong>Eucalyptus + Lavender Blend ShowerSpa Mist</strong> and the comforting <strong>Sleep Well Lavender + Eucalyptus Pillow Mist</strong>. The perfect companions for unwinding after a long day, these products blend the calming aroma of French lavender with the soothing essence of eucalyptus. Whether preparing for sleep or indulging in a relaxing shower, the Calm Collection transforms your routine into a sanctuary of tranquility.</p>",
              "button_label": "Explore",
              "button_link": "shopify://collections/calm"
            }
          },
          "row_hXxk6m": {
            "type": "row",
            "settings": {
              "image": "shopify://shop_images/11_0f849f35-6627-49a6-ad87-23aba29302cb.png",
              "caption": "Spa Profile",
              "heading": "Bliss",
              "text": "<p>Indulge in the luxurious <strong>Bliss Collection</strong>, where exotic aromas meet ultimate relaxation. The collection includes the tropical <strong>Eucalyptus + Jasmine Blend ShowerSpa Mist</strong>, infused with jasmine and ylang-ylang for a mood-lifting experience, and the restful <strong>Sleep Well Lavender + Eucalyptus Pillow Mist</strong>, ensuring a peaceful night's sleep. Perfect for moments of self-care, this collection enhances relaxation with a touch of elegance.</p>",
              "button_label": "Explore",
              "button_link": "shopify://collections/bliss"
            }
          },
          "row_ab88DA": {
            "type": "row",
            "settings": {
              "image": "shopify://shop_images/Screenshot_2024-11-27_at_5.49.26_PM.png",
              "caption": "Spa Profile",
              "heading": "Woodsmoke + Leather",
              "text": "<p>Experience the bold and rugged <strong>Masculine Collection</strong>, highlighted by the distinctive <strong>Woodsmoke + Leather ShowerSpa Mist</strong>. This blend combines 100% natural eucalyptus with warm notes of cedarwood, cherry, clove, and vanilla to create a sophisticated and comforting aroma. Designed for those who appreciate a refined yet earthy scent, this collection is ideal for grounding your senses after a long day or a brisk outdoor adventure.</p>",
              "button_label": "Explore",
              "button_link": "shopify://collections/masculine"
            }
          },
          "row_B4hagq": {
            "type": "row",
            "settings": {
              "image": "shopify://shop_images/6_7c9d68e4-5732-496c-9446-eb90794a0802.png",
              "caption": "Spa Profle",
              "heading": "Sensual",
              "text": "<p>Ignite passion and romance with the <strong>Sensual Collection</strong>, featuring the enchanting <strong>Eucalyptus + Jasmine Blend ShowerSpa Mist</strong>. This exotic blend of jasmine, ylang-ylang, and eucalyptus creates an ambiance of love and connection, perfect for intimate moments or simply pampering yourself. The Sensual Collection is your go-to for transforming any shower into an indulgent escape.</p>",
              "button_label": "Explore",
              "button_link": "shopify://collections/sensual"
            }
          }
        },
